# Cloudflare static-assets response headers.

# Next.js static export writes the share images without a file extension, so declare the type.
/opengraph-image
  Content-Type: image/png
/blog/*/opengraph-image
  Content-Type: image/png

# Fingerprinted build output never changes at a given URL.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
