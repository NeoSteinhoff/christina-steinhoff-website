# Transactional email for the contact/newsletter/referral/application/quiz
# forms (app/api/contact/route.ts). Preferred over Formspree below.
# Get a key at https://resend.com — RESEND_API_KEY.
RESEND_API_KEY=
# Must be a verified sending domain/address in Resend.
CONTACT_FROM_EMAIL="Website <noreply@christinasteinhoff.com>"

# Fallback form backend if Resend isn't configured — https://formspree.io
# Create a form, copy the ID from the endpoint URL (formspree.io/f/<id>).
FORMSPREE_FORM_ID=

# --- Meta (Facebook/Instagram) Ads — Pixel + Conversions API ---
# All three are optional and independently no-op until set: with none of
# them configured, no Meta tracking code loads and no CAPI calls are made.
#
# 1. NEXT_PUBLIC_META_PIXEL_ID — from Meta Events Manager → Data Sources →
#    your pixel → Settings. Exposed to the browser (hence NEXT_PUBLIC_) so
#    the client-side Pixel script (components/ui/CookieConsent.tsx) can
#    load — it only loads after a visitor accepts cookies.
NEXT_PUBLIC_META_PIXEL_ID=
# 2. META_PIXEL_ID — same numeric ID as above, but read server-side
#    (lib/meta-capi.ts) for the Conversions API relay. Kept as a separate
#    var from the NEXT_PUBLIC_ one on purpose — server code should never
#    depend on a client-exposed env var.
META_PIXEL_ID=
# 3. META_CAPI_ACCESS_TOKEN — Events Manager → your pixel → Settings →
#    Conversions API → "Set up manually" → "Generate access token".
#    Server-side only; never expose this to the browser.
META_CAPI_ACCESS_TOKEN=
# Optional — Events Manager → your pixel → Test events tab. Set this
# temporarily while verifying the integration so events show up live in
# the "Test events" view instead of just production Events Manager; remove
# it once verified (events sent with a test code don't count in reporting).
META_CAPI_TEST_EVENT_CODE=
